# ==============================================================================
# SISTEMA CAPÍTULO PROFESSOR CARVALHO NEVES Nº 500 — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local em ambiente de desenvolvimento ou configure
# as variáveis no painel da sua plataforma de deploy (ex: Vercel, Supabase).
# NUNCA comite chaves de produção ou secrets no repositório Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados, Autenticação, Storage e RLS)
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co

# Chave pública (anon / publishable) para consultas do browser sujeitas ao RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-supabase-anon-key-aqui

# Chave privilegiada (service_role) — estritamente utilizada no backend/servidor
# ATENÇÃO: NUNCA exponha esta chave com prefixo NEXT_PUBLIC_ ou no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# ------------------------------------------------------------------------------
# 2. GOOGLE RECAPTCHA v2 (Proteção contra brute-force e robôs no Login/Primeiro Acesso)
# ------------------------------------------------------------------------------
# Chave pública do site para renderizar o widget reCAPTCHA v2 "Não sou um robô"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=sua-recaptcha-site-key-aqui

# Chave secreta de validação consumida pela rota de servidor /api/auth/verify-captcha
RECAPTCHA_SECRET_KEY=sua-recaptcha-secret-key-aqui

# ------------------------------------------------------------------------------
# 3. INFINITEPAY / PIX (Módulo de Tesouraria e Webhook de Conciliação Financeira)
# ------------------------------------------------------------------------------
# Segredo de validação da assinatura HMAC SHA-256 dos webhooks da InfinitePay
INFINITEPAY_WEBHOOK_SECRET=seu-webhook-secret-aqui

# Chave de API InfinitePay para geração de cobranças e links Pix
INFINITEPAY_API_KEY=sua-infinitepay-api-key-aqui

# Identificador / Handle do Capítulo para checkout Pix na InfinitePay
NEXT_PUBLIC_INFINITEPAY_HANDLE=capitulo-carvalho-neves-500
INFINITEPAY_HANDLE=capitulo-carvalho-neves-500
